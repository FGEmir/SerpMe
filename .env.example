# Kopyalayıp .env olarak kaydedin; ardından sunucuyu yeniden başlatın.
SERPAPI_KEY=serpapi_anahtariniz_buraya
# Fotogerçekçi konsept renderı varsayılan olarak kapalıdır. Anahtarı yalnızca
# Render ortam değişkenlerine ekleyin; bu dosyayı veya tarayıcı kodunu kullanmayın.
OPENAI_API_KEY=
CONCEPT_RENDER_ENABLED=false
MAX_CONCEPT_RENDERS_PER_HOUR=12
MAX_CONCEPT_RENDERS_PER_CLIENT_HOUR=2
